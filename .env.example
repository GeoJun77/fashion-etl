# Copy to .env and adjust : cp .env.example .env

# Database — defaults to fashion.db (SQLite) at the project root. PostgreSQL example :
# DATABASE_URL=postgresql://fashion:fashion123@localhost:5432/fashion_etl

# Sources
# Awin product feed : download URL from the Awin dashboard, or a local path to the .zip
AWIN_FEED_URL=
# Synthetic data for offline development only — keep false for real runs
USE_MOCK=false

# Scraping
SCRAPE_DELAY=2
MAX_PRODUCTS=500

# Scheduling (python main.py --schedule)
SCHEDULE_HOURS=6

# Logging
LOG_LEVEL=INFO
